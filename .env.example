# Copier en .env et remplir. Ne jamais versionner .env.

# Mot de passe de la base PostgreSQL du conteneur.
NPA_DB_PASSWORD=

# Clés de l'application : générez-les avec
#   docker compose run --rm --no-deps --entrypoint npa api generer-cles
# NPA_SECRET_KEY signe les jetons ; NPA_CLE_CHIFFREMENT chiffre les secrets TOTP.
# Perdre NPA_CLE_CHIFFREMENT oblige à réinitialiser le TOTP de tous les comptes.
NPA_SECRET_KEY=
NPA_CLE_CHIFFREMENT=

# Facultatif
# NPA_EMETTEUR_TOTP=NormaPrep Audit
# NPA_DUREE_JETON_ACCES_MINUTES=480
