# Copier en .env et renseigner au moins NPA_DB_PASSWORD. Ne jamais versionner .env.

# Mot de passe de la base PostgreSQL du conteneur (à choisir).
# Ne le changez plus après le premier lancement : la base garde celui de sa création.
NPA_DB_PASSWORD=

# Clés de l'application. Laissez-les vides : elles sont générées au premier
# démarrage et conservées dans un volume Docker. Pour les sauvegarder :
#   docker compose exec api npa afficher-cles
# Pour fournir vos propres clés, décommentez et remplissez (npa generer-cles).
# NPA_SECRET_KEY=
# NPA_CLE_CHIFFREMENT=

# Facultatif
# NPA_EMETTEUR_TOTP=NormaPrep Audit
# NPA_DUREE_JETON_ACCES_MINUTES=480
